# Turnwise waker configuration (read by /usr/local/bin/waker.py)
# Example values: copy to /etc/waker.conf on the phone and fill in your own MACs and addresses.
SERVER_MAC=aa:bb:cc:dd:ee:01
SERVER_HOST=192.168.1.2
SERVER_PORT=22
LLM_MAC=aa:bb:cc:dd:ee:02
LLM_HOST=<llm-tailscale-ip>
LLM_PORT=11434
# Where the magic packet is sent. Filled in once the network layout is known.
BROADCASTS=192.168.1.255,255.255.255.255
LISTEN=0.0.0.0:8490
SERVER_SSH=user@192.168.1.2
LLM_SSH=
SSH_KEY=/root/.ssh/waker_key
UPSTREAM=https://<box>.<tailnet>.ts.net:8446
PROXY_PORT=8447
WAKE_WAIT=150
READY_PATH=/api/me
